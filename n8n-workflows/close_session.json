{
  "name": "LinkedIn MCP - Close Session",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/mcp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: 'close_session', arguments: {} } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-close",
      "name": "Close Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "parse-status",
              "name": "status",
              "value": "={{ JSON.parse($json.result.content[0].text).status }}",
              "type": "string"
            },
            {
              "id": "parse-message",
              "name": "message",
              "value": "={{ JSON.parse($json.result.content[0].text).message }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "parse-result",
      "name": "Parse Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [640, 300]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [{ "node": "Close Session", "type": "main", "index": 0 }]
      ]
    },
    "Close Session": {
      "main": [
        [{ "node": "Parse Result", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    { "name": "LinkedIn" },
    { "name": "MCP" },
    { "name": "Session" }
  ],
  "pinData": {}
}
