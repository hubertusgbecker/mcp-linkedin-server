{
  "name": "LinkedIn MCP - Notifications Then Post Content",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "param-limit",
              "name": "limit",
              "value": 5,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "set-params",
      "name": "Set Notification Limit",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/mcp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: 'get_notifications', arguments: { limit: $json.limit } } }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "http-notifications",
      "name": "Get Notifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "parse-notifs",
              "name": "notifications",
              "value": "={{ JSON.parse($json.result.content[0].text).notifications }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "parse-notifs",
      "name": "Parse Notifications",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [860, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "notifications",
        "options": {}
      },
      "id": "split-notifs",
      "name": "Split Notifications",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-post-url",
              "leftValue": "={{ $json.notifications.post_url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-has-url",
      "name": "Has Post URL?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/mcp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: 'get_post_content', arguments: { post_url: $json.notifications.post_url } } }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "http-post-content",
      "name": "Get Post Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "parse-post",
              "name": "post",
              "value": "={{ JSON.parse($json.result.content[0].text) }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "parse-post",
      "name": "Parse Post Content",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1740, 300]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [{ "node": "Set Notification Limit", "type": "main", "index": 0 }]
      ]
    },
    "Set Notification Limit": {
      "main": [
        [{ "node": "Get Notifications", "type": "main", "index": 0 }]
      ]
    },
    "Get Notifications": {
      "main": [
        [{ "node": "Parse Notifications", "type": "main", "index": 0 }]
      ]
    },
    "Parse Notifications": {
      "main": [
        [{ "node": "Split Notifications", "type": "main", "index": 0 }]
      ]
    },
    "Split Notifications": {
      "main": [
        [{ "node": "Has Post URL?", "type": "main", "index": 0 }]
      ]
    },
    "Has Post URL?": {
      "main": [
        [{ "node": "Get Post Content", "type": "main", "index": 0 }]
      ]
    },
    "Get Post Content": {
      "main": [
        [{ "node": "Parse Post Content", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    { "name": "LinkedIn" },
    { "name": "MCP" },
    { "name": "Notifications" },
    { "name": "Pipeline" }
  ],
  "pinData": {}
}
