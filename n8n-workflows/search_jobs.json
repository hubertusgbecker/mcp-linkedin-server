{
  "name": "LinkedIn MCP - Search Jobs",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "param-keywords",
              "name": "keywords",
              "value": "software engineer",
              "type": "string"
            },
            {
              "id": "param-location",
              "name": "location",
              "value": "Germany",
              "type": "string"
            },
            {
              "id": "param-limit",
              "name": "limit",
              "value": 10,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "set-params-1",
      "name": "Set Search Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/mcp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: 'search_jobs', arguments: { keywords: $json.keywords, location: $json.location, limit: $json.limit } } }) }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "http-1",
      "name": "Call MCP - Search Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "parse-result",
              "name": "search_results",
              "value": "={{ JSON.parse($json.result.content[0].text) }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "parse-1",
      "name": "Parse Search Results",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [860, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "search_results.job_urls",
        "options": {}
      },
      "id": "split-1",
      "name": "Split Job URLs",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1080, 300]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [{ "node": "Set Search Parameters", "type": "main", "index": 0 }]
      ]
    },
    "Set Search Parameters": {
      "main": [
        [{ "node": "Call MCP - Search Jobs", "type": "main", "index": 0 }]
      ]
    },
    "Call MCP - Search Jobs": {
      "main": [
        [{ "node": "Parse Search Results", "type": "main", "index": 0 }]
      ]
    },
    "Parse Search Results": {
      "main": [
        [{ "node": "Split Job URLs", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    { "name": "LinkedIn" },
    { "name": "MCP" },
    { "name": "Jobs" }
  ],
  "pinData": {}
}
